# --- Secrets (obligatoires) ---
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret
ANTHROPIC_API_KEY=sk-ant-...
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# --- Options (valeurs par défaut indiquées) ---
# Chemin de la base SQLite dans le conteneur
DB_PATH=/data/prices.db

# Routes surveillées (origine-destination, séparées par des virgules)
ROUTES=TLS-ORY,TLS-CDG

# Nombre de week-ends (vendredi->dimanche) à suivre automatiquement
WEEKEND_COUNT=8

# Fréquence de collecte en heures
COLLECT_INTERVAL_HOURS=4

# Quota mensuel Amadeus et marge de sécurité (réduction à 80% du quota)
AMADEUS_MONTHLY_QUOTA=2000
QUOTA_SAFETY_RATIO=0.80

# Seuils de détection
ABSOLUTE_PRICE_THRESHOLD_EUR=60
SCORE_ALERT_THRESHOLD=80

# Poids du scoring (doivent sommer à 1.0)
WEIGHT_PRICE=0.45
WEIGHT_SCHEDULE=0.25
WEIGHT_COMFORT=0.20
WEIGHT_TREND=0.10

# Fenêtre de baseline (médiane glissante) en jours
BASELINE_WINDOW_DAYS=30

# Préférences de confort (codes IATA compagnies, séparés par des virgules)
PREFERRED_CARRIERS=
AVOIDED_CARRIERS=
MAX_REASONABLE_DURATION_MIN=90

# LLM
LLM_MODEL=claude-opus-4-8
LLM_MAX_TOKENS=1024

# Digest quotidien
DIGEST_HOUR=8
TIMEZONE=Europe/Paris
