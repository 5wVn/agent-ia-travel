# --- Secrets (obligatoires) ---
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# --- LLM (OPTIONNEL) ---
# ANTHROPIC_API_KEY est facultative. Si elle est absente ou vide, l'agent tourne
# en « mode sans LLM » : recos et digest générés par des messages template
# (médiane, composantes du score, tendance). Tout le reste (collecte, scoring,
# détection, sniper) fonctionne à l'identique. Aucun appel réseau Anthropic
# n'est tenté et un seul log « Mode sans LLM » est émis au démarrage.
ANTHROPIC_API_KEY=

# --- Options (valeurs par défaut indiquées) ---
# Chemin de la base SQLite dans le conteneur
DB_PATH=/data/prices.db

# Routes surveillées (origine-destination, séparées par des virgules)
ROUTES=TLS-ORY,TLS-CDG

# Nombre de week-ends (vendredi->dimanche) à suivre automatiquement
WEEKEND_COUNT=8

# Fréquence de collecte en heures
COLLECT_INTERVAL_HOURS=4

# Quota mensuel Amadeus et marge de sécurité (réduction à 80% du quota)
AMADEUS_MONTHLY_QUOTA=2000
QUOTA_SAFETY_RATIO=0.80

# Seuils de détection
ABSOLUTE_PRICE_THRESHOLD_EUR=60
SCORE_ALERT_THRESHOLD=80

# Poids du scoring (doivent sommer à 1.0)
WEIGHT_PRICE=0.45
WEIGHT_SCHEDULE=0.25
WEIGHT_COMFORT=0.20
WEIGHT_TREND=0.10

# Fenêtre de baseline (médiane glissante) en jours
BASELINE_WINDOW_DAYS=30

# Préférences de confort (codes IATA compagnies, séparés par des virgules)
PREFERRED_CARRIERS=
AVOIDED_CARRIERS=
MAX_REASONABLE_DURATION_MIN=90

# LLM (ignoré en mode sans LLM)
LLM_MODEL=claude-opus-4-8
LLM_MAX_TOKENS=1024

# Digest quotidien
DIGEST_HOUR=8
TIMEZONE=Europe/Paris

# --- Sniper de prix (seuils armés, PLAN.md étape 4bis) ---
# Cadence de la surveillance boostée (minutes) sur les dates snipées proches.
SNIPE_INTERVAL_MINUTES=15
# Une date n'est surveillée que si son meilleur prix < seuil * ce ratio.
SNIPE_PROXIMITY_RATIO=1.15
# Re-ping de l'alerte critique : cadence (minutes) et nombre maximum.
SNIPE_REPING_INTERVAL_MINUTES=5
SNIPE_REPING_MAX=6
# Grille de saisie du seuil (montants en €) et pagination.
SNIPE_AMOUNT_MIN_EUR=30
SNIPE_AMOUNT_MAX_EUR=120
SNIPE_AMOUNT_STEP_EUR=5
SNIPE_GRID_PAGE_SIZE=18
